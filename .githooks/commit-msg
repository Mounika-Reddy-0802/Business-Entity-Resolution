#!/usr/bin/env bash
# Rejects attribution trailers, tool footers and banned or vague messages. Backstop for GIT_RULES.md.
msg="$(grep -v '^#' "$1")"
if echo "$msg" | grep -qiE 'co-authored-by|generated with|generated by|made by|written by|on behalf of'; then
  echo "commit-msg: attribution trailer or tool footer found; only the three members appear in history" >&2; exit 1; fi
first="$(echo "$msg" | sed -n '1p' | tr '[:upper:]' '[:lower:]' | xargs)"
case "$first" in
  update|updated|fix|fixes|changes|change|commit|final|final2|asdf|wip|"work done"|"minor fix"|"updated code"|"pushed files"|"")
    echo "commit-msg: '$first' is banned; say what changed" >&2; exit 1;; esac
if echo "$first" | grep -qE '^\['; then echo "commit-msg: no bracketed prefixes" >&2; exit 1; fi
if echo "$first" | grep -qiE 'comprehensive|robust|extensive|advanced functionality|overall system'; then
  echo "commit-msg: inflated wording; say what changed" >&2; exit 1; fi
exit 0
